{
  "private": "true",
  "name": "icrc1-auction",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/research-ag/icrc1-auction.git",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "create": "icp deploy",
    "dev:frontend": "vite --port 3993 --host",
    "generate:bindings": "mops build icrc1_ledger_mock && icp-bindgen --did-file did/icrc1_auction.did --out-dir frontend/src/bindings && icp-bindgen --did-file .mops/.build/icrc1_ledger_mock.did --out-dir frontend/src/bindings && icp-bindgen --did-file crypto_canister/crypto.did --out-dir frontend/src/bindings",
    "build:frontend": "rm -rf ./dist/ && npm run generate:bindings && tsc && vite build",
    "dev:crypto-test": "vite --config vite.crypto-test.config.ts --port 4001 --host",
    "format": "prettier --write '**/*.{mo,json,md,ts,tsx,js}'",
    "format:check": "prettier --check '**/*.{mo,json,md,ts,tsx,js}'",
    "test": "jest -c ./test/jest.config.ts"
  },
  "devDependencies": {
    "@dfinity/pic": "^0.22.0",
    "@icp-sdk/bindgen": "^0.3.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "dotenv": "^16.4.4",
    "jest": "^29.7.0",
    "mo-dev": "^0.12.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-motoko": "^0.13.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "^1.3.0"
  },
  "dependencies": {
    "@dfinity/vetkeys": "^0.4.0",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fontsource/inter": "^5.0.16",
    "@hookform/resolvers": "^3.3.4",
    "@icp-sdk/auth": "^5.0.0",
    "@icp-sdk/canisters": "^3.4.0",
    "@icp-sdk/core": "^5.0.0",
    "@mui/icons-material": "^5.15.10",
    "@mui/joy": "^5.0.0-beta.28",
    "@mui/material": "^5.15.10",
    "@research-ag/ckbtc-address-js": "^0.0.3",
    "@research-ag/ic-web-push": "^0.1.2",
    "date-fns": "^3.3.1",
    "notistack": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.1",
    "react-query": "^3.39.3",
    "zod": "^3.22.4"
  }
}
